{
  "manifest_version": 3,
  "key": "",
  "name": "Nixie Link",
  "version": "0.1.0",
  "description": "Securely links this browser profile's YouTube session to the Nixie desktop app on this computer.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "nativeMessaging", "alarms", "storage"],
  "host_permissions": ["*://*.youtube.com/"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nixie Link"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
